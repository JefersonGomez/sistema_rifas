# Caddy saca y renueva solo el certificado HTTPS de Let's Encrypt.
# Instalar: sudo cp despliegue/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Cambiar el subdominio si se registró otro en DuckDNS.
rifasivannia.duckdns.org {
	encode zstd gzip

	# Fotos de hasta 5 MB más un margen.
	request_body {
		max_size 6MB
	}

	reverse_proxy 127.0.0.1:3000
}
