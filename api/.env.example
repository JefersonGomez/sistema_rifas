# Conexión con pooler de Neon (la usa la app)
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Conexión directa de Neon, sin "-pooler" (la usa Prisma para migraciones)
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
TZ=America/Costa_Rica

# Firma de la sesión. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambiar-por-un-texto-aleatorio-de-al-menos-32-caracteres"

# Carpeta de las fotos de los premios (relativa a api/)
UPLOAD_DIR=uploads
