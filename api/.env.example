# Conexión con pooler de Neon (la usa la app)
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Conexión directa de Neon, sin "-pooler" (la usan Prisma para migraciones y pg_dump para respaldos)
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
TZ=America/Costa_Rica

# Firma de la sesión. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambiar-por-un-texto-aleatorio-de-al-menos-32-caracteres"

# Carpeta de las fotos de los premios (relativa a api/)
UPLOAD_DIR=uploads

# --- Solo en el VPS (producción) ---
# NODE_ENV=production   # sirve la web compilada y exige HTTPS en la cookie
# HOST=127.0.0.1        # solo Caddy puede llegar a la app
# TRUST_PROXY=1         # Caddy está delante: usar la IP real del visitante

# Dirección pública (para la miniatura al compartir en WhatsApp)
# APP_URL=https://rifasivannia.duckdns.org
